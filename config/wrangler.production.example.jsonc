// Reference copy of the production configuration. The deploy workflow
// (.github/workflows/deploy-production.yml) writes its own fixed copy; that copy is authoritative.
// Secrets are deliberately absent. routes stays empty: the hostname is attached separately.
{
  "name": "afnan-collection-production",
  "account_id": "b4e142fe9da84ef204eecda2efe4a730",
  "main": "../worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../.output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://afnancollectionkn.com",
    "CHECKOUT_ENABLED": "false",
    "PAYMENT_MODE": "disabled",
    "EMAIL_FROM": "noreply@afnancollectionkn.com",
    "EMAIL_SENDER_VERIFIED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afnan-collection-production",
      "database_id": "73ddfc46-34ba-4733-841d-e4819af0b957",
      "migrations_dir": "../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "afnan-product-media-production",
    },
    {
      "binding": "RECEIPTS",
      "bucket_name": "afnan-payment-receipts-production",
    },
  ],
}
