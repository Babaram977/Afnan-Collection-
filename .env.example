# Local development only: copy to .dev.vars (ignored by Git).
# Generate AUTH_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional verified transactional email account. Never expose these as VITE_*.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Paystack TEST secret only. Live keys are deliberately rejected.
PAYSTACK_SECRET_KEY=
